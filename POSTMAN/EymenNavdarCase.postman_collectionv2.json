                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.set(\"token\", \"\");",
                                    "    pm.environment.set(\"token\", \"\");",
                                    "    pm.globals.set(\"token\", \"\");",
                                    "    console.log(\"Cikis yapildi, token sifirlandi.\");",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
